# Copy to .env.development, .env.preprod, or .env.production and adjust values.
# Vite loads .env.[mode] based on npm script mode.

VITE_APP_ENV=development
VITE_API_BASE=http://localhost:8081
VITE_LOGTO_ENDPOINT=https://your-logto-endpoint.logto.app
VITE_LOGTO_APP_ID=your-logto-app-id
VITE_LOGTO_API_RESOURCE=http://localhost:8081/api
VITE_LOGTO_ORG_ENABLED=false
VITE_LOGTO_ENABLED=false
VITE_LEGACY_AUTH_ENABLED=true
