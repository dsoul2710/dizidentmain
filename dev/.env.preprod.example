# Pre-production environment
# Copy to .env.preprod and update values
# Usage: docker compose -f docker-compose.preprod.yml --env-file .env.preprod up --build -d

DB_PASSWORD=change-me
JWT_SECRET=change-me-use-openssl-rand-base64-64
APP_CORS_ALLOWED_ORIGINS=https://preprod.example.com
VITE_API_BASE=https://api-preprod.example.com
VITE_LOGTO_ENABLED=true
APP_LOGTO_ENABLED=true
LOGTO_ENDPOINT=https://your-logto.logto.app
LOGTO_ISSUER_URI=https://your-logto.logto.app/oidc
LOGTO_APP_ID=your-logto-app-id
LOGTO_API_RESOURCE=https://api-preprod.example.com/api
