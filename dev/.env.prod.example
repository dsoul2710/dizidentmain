# Production environment
# Copy to .env.prod and update values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d

DB_PASSWORD=change-me
JWT_SECRET=change-me-use-openssl-rand-base64-64
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
VITE_API_BASE=https://api.example.com
VITE_LOGTO_ENABLED=true
APP_LOGTO_ENABLED=true
LOGTO_ENDPOINT=https://your-logto.logto.app
LOGTO_ISSUER_URI=https://your-logto.logto.app/oidc
LOGTO_APP_ID=your-logto-app-id
LOGTO_API_RESOURCE=https://api.example.com/api
