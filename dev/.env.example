# Environment variables for clientxyz deployment
# Copy this file to .env and update with your actual values

# Database
DB_PASSWORD=admin123

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=xyz_your_very_long_and_secure_jwt_secret_key_here_change_this

# Frontend API URL (use your domain in production)
VITE_API_BASE=http://localhost:8081
# For production with domain:
# VITE_API_BASE=https://xyz.yourdomain.com
