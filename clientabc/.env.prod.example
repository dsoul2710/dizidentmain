# Client ABC - Production Environment
# Copy this to .env.prod and fill in real values

# PostgreSQL (Shared on VPS)
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# JWT Secret (Min 32 characters)
JWT_SECRET=abc_jwt_secret_key_must_be_at_least_32_characters_long

# API Base URL (from Nginx)
VITE_API_BASE=https://abc.dizidental.cloud/api

